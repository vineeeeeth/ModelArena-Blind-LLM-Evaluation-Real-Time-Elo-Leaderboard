# ─── Database ───
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=modelarena
POSTGRES_USER=modelarena
POSTGRES_PASSWORD=changeme_in_production

# ─── Redis ───
REDIS_URL=redis://redis:6379/0

# ─── Backend ───
SECRET_KEY=change-this-to-a-random-64-char-string
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ─── Ollama ───
OLLAMA_BASE_URL=http://ollama:11434

# ─── Optional: hosted LLM providers (leave blank to use Ollama only) ───
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ─── Optional: Google OAuth ───
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── SMTP (Mailpit in dev) ───
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@modelarena.dev
SMTP_TLS=false

# ─── Worker ───
RATING_RECOMPUTE_INTERVAL_MINUTES=5

